diff --git a/kvmem/CMakeLists.txt b/kvmem/CMakeLists.txt
index 8aebc42..d624546 100644
--- a/kvmem/CMakeLists.txt
+++ b/kvmem/CMakeLists.txt
@@ -1,9 +1,29 @@
+# Windows: force kvmem to be a STATIC library.
+#
+# The kvmem headers carry no __declspec(dllexport/dllimport) annotations, which
+# is fine on Linux (shared objects export everything by default). MSVC however
+# exports nothing, produces NO import library, and the subsequent
+# `llama.dll` link then fails with
+#     LINK : fatal error LNK1181: cannot open input file 'kvmem\kvmem.lib'
+# Building kvmem statically pulls the objects straight into llama.dll and
+# sidesteps the export/import problem entirely. Linux behaviour is unchanged.
+#
+# Local addition - not part of upstream kvmem.
+if (WIN32)
+    set(_kvmem_saved_build_shared ${BUILD_SHARED_LIBS})
+    set(BUILD_SHARED_LIBS OFF)
+endif()
+
 add_library(kvmem
     src/host/kvmem_store.cpp
     src/host/kvmem_runtime.cpp
     src/host/raw_kv_store.cpp
     src/host/rope.cpp
 )
+
+if (WIN32)
+    set(BUILD_SHARED_LIBS ${_kvmem_saved_build_shared})
+endif()
 set_target_properties(kvmem PROPERTIES POSITION_INDEPENDENT_CODE ON)
 target_include_directories(kvmem PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
 target_compile_features(kvmem PUBLIC cxx_std_17)
